# Copy to a private path outside the public directory; chmod 600.
# Do not set PUBLIC_ORIGIN on an HTTP-only local workstation.
# PUBLIC_ORIGIN=https://demo.example.ru
# APP_IP_HASH_KEY=
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET=

# off / test / production. Set TBANK_TERMINAL_KEY privately; terminal credentials are excluded from GitHub.
TBANK_MODE=off
# TBANK_TERMINAL_KEY=
# TBANK_PASSWORD=
# TBANK_API_BEARER=
# TBANK_PAY_TYPE=O
# TBANK_PRODUCTION_READY=1

# Optional notification destinations.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_TLS=ssl
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
SMTP_TO=kbo-ekb@mail.ru
# BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_THREAD_ID=

# Enable one only after verifying how the existing CRM receives leads.
CRM_MODE=off
